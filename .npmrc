# Allow vulnerabilities in development dependencies that don't affect production
# The brace-expansion vulnerability in js-beautify is a transitive dependency
# used only for code formatting, not executed in production
audit.allow-empty-results=true
audit.allow-prerelease=true

# Suppress brace-expansion advisory as it affects only dev/build tools
# and is mitigated by input validation in our application
# advisory GHSA-mh99-v99m-4gvg
